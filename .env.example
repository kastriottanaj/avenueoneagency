# Avenue One Agency — environment configuration.
#
# Copy to .env (git-ignored) for local work, or install as the systemd
# EnvironmentFile in production. NEVER commit the real file.
#
# Every value below was previously hardcoded in avenueoneagency/settings.py and
# committed to a public repository. Anything marked ROTATE must be reissued,
# because the old value is in the git history permanently.

DEBUG=False

# ROTATE. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

DJANGO_ALLOWED_HOSTS=avenueoneagency.com,www.avenueoneagency.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://avenueoneagency.com,https://www.avenueoneagency.com
DJANGO_CORS_ALLOWED_ORIGINS=https://avenueoneagency.com,https://www.avenueoneagency.com

# The hostname everything else 301s to. Set to the www form to invert.
CANONICAL_HOST=avenueoneagency.com

# ROTATE — the old password is in the git history.
DATABASE_URL=postgresql://avenueoneagency:replace-me@127.0.0.1:5432/avenueoneagency

# ROTATE — the old Google App Password is in the git history. Revoke it at
# https://myaccount.google.com/apppasswords before issuing a new one.
#
# Keep the double quotes: Google shows the password as four space-separated
# groups, and both systemd and `source` split unquoted values on whitespace.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=avenueoneagency@gmail.com
EMAIL_HOST_PASSWORD="replace me with gmail app password"

# Contact-form notifications are sent FROM this address, with the visitor's
# address as Reply-To. It must be an address this server is authorised to send
# for, or SPF/DMARC alignment fails and the mail is spam-filtered.
DEFAULT_FROM_EMAIL=avenueoneagency@gmail.com
CONTACT_RECEIVER_EMAIL=avenueoneagency@gmail.com

# Rate limits for the unauthenticated public endpoints, per IP.
THROTTLE_CONTACT=5/hour
THROTTLE_NEWSLETTER=5/hour

# HSTS. Now on by default at one year. includeSubDomains and preload stay off
# until every subdomain is confirmed HTTPS-only — both are hard to reverse.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

DJANGO_LOG_LEVEL=INFO
