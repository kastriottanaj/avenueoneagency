# Production environment for Avenue One Agency.
#
# On the server this lives at /etc/avenueoneagency/env, owned by root:avenue
# with mode 640. It is read by the gunicorn systemd unit (EnvironmentFile=)
# and sourced by deploy/deploy.sh for management commands.
#
# NEVER commit the real file. This example carries placeholders only.

DEBUG=False

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

DJANGO_ALLOWED_HOSTS=avenueoneagency.com,www.avenueoneagency.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://avenueoneagency.com,https://www.avenueoneagency.com
DJANGO_CORS_ALLOWED_ORIGINS=https://avenueoneagency.com,https://www.avenueoneagency.com

# Local Postgres over the unix socket's TCP equivalent on loopback.
DATABASE_URL=postgresql://avenueoneagency:replace-me-with-db-password@127.0.0.1:5432/avenueoneagency

# Gmail SMTP. EMAIL_HOST_PASSWORD is a Google App Password, not the account
# password. Google shows it as four space-separated groups — keep the double
# quotes, otherwise systemd and `source` both split the value on whitespace.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=avenueoneagency@gmail.com
EMAIL_HOST_PASSWORD="replace me with gmail app password"
DEFAULT_FROM_EMAIL=avenueoneagency@gmail.com
CONTACT_RECEIVER_EMAIL=avenueoneagency@gmail.com

# Leave at 0 until HTTPS is confirmed working on both apex and www, then raise
# to 604800 (1 week) and finally 31536000 (1 year). HSTS is hard to undo:
# browsers cache it for the full duration.
SECURE_HSTS_SECONDS=0
